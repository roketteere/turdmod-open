# AUTO-GENERATED by ~/.claude/scripts/claudeignore-sync.ps1
# Source:
#   master = ~/.claude/claudeignore-master
#   local  = <this project>/.claudeignore.local  (optional)
#
# DO NOT hand-edit this file. Edit the master or .claudeignore.local
# and re-run the sync script. Otherwise your changes get clobbered on
# the next sync.
#
# Canonical .claudeignore template -- copy this to every new project.
# Filters everything Claude can't usefully process (binary data, build
# artifacts, vendored deps). Saves real tokens; measured 36GB+ of pure
# noise in this repo before this file existed.

# Dependencies & build artifacts ------------------------------------------------
node_modules/
**/node_modules/
tmp/
.claude/
apps/extractor/
apps/turdmod-loader.zip
packages/turdmod-api/
packages/turdmod-manifest/
.venv/
**/.venv/
venv/
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.egg-info/

# Rust / Tauri / Cargo --------------------------------------------------------
**/target/
**/.cargo/

# Frontend build outputs ------------------------------------------------------
**/.next/
**/.turbo/
**/dist/
**/build/
**/out/
**/.vite/

# Native compile outputs ------------------------------------------------------
**/*.dll
**/*.exe
**/*.pdb
**/*.lib
**/*.obj
**/*.so
**/*.dylib
**/*.a
**/*.o

# Lock files (Claude only needs package.json / Cargo.toml / pyproject.toml) ---
pnpm-lock.yaml
package-lock.json
yarn.lock
Cargo.lock
uv.lock
poetry.lock

# Version control -------------------------------------------------------------
.git/

# Image / icon assets (Claude can't process binary image data) ---------------
img/
images/
screenshots/
*.png
*.webp
*.jpg
*.jpeg
*.gif
*.bmp
*.tiff
*.svg
*.ico
*.icns

# Audio / video ---------------------------------------------------------------
*.mp3
*.wav
*.ogg
*.flac
*.m4a
*.aac
*.mp4
*.mov
*.avi
*.webm
*.mkv
*.wmv

# Archives --------------------------------------------------------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.gz
*.bz2
*.7z
*.rar

# Documents -------------------------------------------------------------------
*.pdf
*.docx
*.doc
*.xlsx
*.xls
*.pptx
*.ppt

# 3D / game models ------------------------------------------------------------
*.fbx
*.glb
*.gltf
*.stl
*.blend
*.blend1
*.dae
*.ply
*.usd
*.usdz

# Fonts -----------------------------------------------------------------------
*.woff
*.woff2
*.ttf
*.otf
*.eot

# Unreal Engine / SCUM / Unity game assets -----------------------------------
*.pak
*.sig
*.uasset
*.umap
*.uplugin
*.uproject
*.uexp
*.ubulk
*.asset
*.unity
*.unitypackage

# Machine-learning artifacts (huge, opaque) -----------------------------------
*.safetensors
*.gguf
*.ggml
*.onnx
*.tflite
*.pt
*.pth
*.ckpt
*.h5
*.bin

# Database / data files (often huge, not source) -----------------------------
*.sqlite
*.sqlite3
*.db
*.parquet
*.lance/
*.arrow

# Generated reflection / asset dumps -----------------------------------------
scumdump/data/extracted/

# Sensitive Information -------------------------------------------------------
.env
.env.local
.env.*.local
.secrets/

# Optional: examples folder if redundant to core logic -----------------------
examples/
