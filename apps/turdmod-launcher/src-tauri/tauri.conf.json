{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TurdMOD Launcher",
  "version": "0.1.0",
  "identifier": "com.turdmod.launcher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5180",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TurdMOD Launcher",
        "label": "main",
        "decorations": false,
        "transparent": true,
        "width": 1100,
        "height": 700,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Joel Perez (TurdMOD)",
    "category": "Game",
    "shortDescription": "DayZ-style modded client launcher for TurdMOD servers.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../turdmod-loader/target/release/turdmod_loader.dll": "turdmod_loader.dll"
    }
  }
}
