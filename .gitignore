# verify-dossier generated reports (regenerable)
docs/engine/research/**/*.verified.md
docs/engine/research/*.verified.md

# Live OVH SCUM server config snapshot — local-only, lobe-indexed, NEVER commit (SteamIDs/passwords)
docs/scum-config-live/

# Ops scratch — never commit. Holds SCUM.db copies (player PII), build logs,
# briefs, and anything that may briefly hold secrets. The whole dir is scratch.
tmp/
**/discord.json

# Runtime player analytics — PII (names, SteamIDs, position history). Never commit.
apps/turdmod-service/src/data/analytics/

# Runtime data directories (service state, analytics)
apps/turdmod-service/data/
data/analytics/

# Build bundles (regenerable, deployed via scripts)
apps/turdmod-bot/dist-bundle/
apps/turdmod-companion/dist-bundle/

# Cross-session comms + build logs (machine-local)
master/
messenger/

# Stray temp archives
apps/$RQE89OY.tar

# Local convenience scripts (machine-specific, not portable)
open-admin-here.bat
apps/*/open-admin-here.bat

# Tauri icon backups (pre-rebrand snapshots, not source)
apps/*/src-tauri/icons/_pre-turd-backup/

