# Hoist Next.js's runtime peer deps to the workspace-root node_modules
# so the standalone build (apps/turdmod-web) can resolve them at runtime
# in production. Without this, pnpm's nested store layout hides
# `styled-jsx` (and similar) from Node's CJS resolver and Passenger
# crashes with "Cannot find module 'styled-jsx/package.json'" the first
# time it tries to render a page.
#
# Public-hoist-pattern only hoists to the workspace root; pnpm's regular
# store + per-package symlinks otherwise stay strict.
public-hoist-pattern[]=*styled-jsx*
public-hoist-pattern[]=@swc/helpers
public-hoist-pattern[]=client-only
public-hoist-pattern[]=server-only
